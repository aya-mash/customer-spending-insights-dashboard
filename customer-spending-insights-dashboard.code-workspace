{
  "folders": [
    {
      "path": ".",
      "name": "Customer Spending Insights Dashboard"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [80, 120],
    "editor.wordWrap": "off",
    "editor.minimap.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/.vite": true,
      "**/coverage": true,
      "**/.storybook-static": true,
      "**/storybook-static": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/coverage": true,
      "**/.vite": true,
      "**/yarn.lock": true,
      "**/*.lock": true
    },
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "eslint.options": {
      "extensions": [".js", ".jsx", ".ts", ".tsx"]
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "bash",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "vitest.enable": true,
    "vitest.commandLine": "yarn test",
    "playwright.reuseBrowser": true,
    "playwright.showTrace": true,
    "css.validate": true,
    "css.lint.unknownAtRules": "ignore",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.spec.ts, ${capture}.test.ts",
      "*.tsx": "${capture}.spec.tsx, ${capture}.test.tsx, ${capture}.stories.tsx",
      "*.js": "${capture}.spec.js, ${capture}.test.js",
      "*.jsx": "${capture}.spec.jsx, ${capture}.test.jsx, ${capture}.stories.jsx",
      "package.json": "package-lock.json, yarn.lock, .npmrc, .yarnrc",
      "tsconfig.json": "tsconfig.*.json",
      "vite.config.*": "vitest.config.*",
      ".eslintrc.*": ".eslintignore, .prettierrc.*, .prettierignore",
      "README.md": "README_*.md, CONTRIBUTING.md, SECURITY.md"
    },
    "cSpell.words": [
      "tanstack",
      "recharts",
      "lucide",
      "capitec",
      "donut",
      "vitest",
      "jsdom",
      "devcontainer",
      "prefers",
      "describedby",
      "browserslist",
      "vite",
      "storybook"
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "vitest.explorer",
      "ms-playwright.playwright",
      "formulahendry.auto-rename-tag",
      "christian-kohler.path-intellisense",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens",
      "ms-azuretools.vscode-docker",
      "eamodio.gitlens",
      "yzhang.markdown-all-in-one",
      "davidanson.vscode-markdownlint",
      "gruntfuggly.todo-tree",
      "editorconfig.editorconfig"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "chrome",
        "request": "launch",
        "name": "Launch Chrome - Dev Server",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/src",
        "sourceMaps": true,
        "preLaunchTask": "dev-server"
      },
      {
        "type": "chrome",
        "request": "launch",
        "name": "Launch Chrome - Storybook",
        "url": "http://localhost:6006",
        "webRoot": "${workspaceFolder}/src",
        "sourceMaps": true,
        "preLaunchTask": "storybook-server"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Run Tests",
        "runtimeExecutable": "yarn",
        "runtimeArgs": ["test"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev-server",
        "type": "shell",
        "command": "yarn",
        "args": ["dev"],
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "VITE",
            "endsPattern": "ready in"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "storybook-server",
        "type": "shell",
        "command": "yarn",
        "args": ["storybook"],
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Storybook",
            "endsPattern": "ready"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "build",
        "type": "shell",
        "command": "yarn",
        "args": ["build"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "test",
        "type": "shell",
        "command": "yarn",
        "args": ["test"],
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "lint",
        "type": "shell",
        "command": "yarn",
        "args": ["lint"],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "problemMatcher": ["$eslint-stylish"]
      },
      {
        "label": "lint:fix",
        "type": "shell",
        "command": "yarn",
        "args": ["lint", "--fix"],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      }
    ]
  }
}
