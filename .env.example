# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production

# Environment name: development, staging, or production
VITE_ENV=development

# API Base URL - use /api for MSW mock mode
VITE_API_BASE_URL=/api

# Application display name
VITE_APP_NAME=Customer Spending Insights

# Enable Mock Service Worker (true for demo without real backend)
VITE_ENABLE_MOCKS=true

# AWS Cognito Configuration for Authentication
# Get these values from AWS Console > Cognito
VITE_AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_AWS_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1

# Optional: Identity Pool for guest access
# VITE_AWS_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sentry Error Tracking (Production only)
# Get your DSN from https://sentry.io/settings/projects/<project>/keys/
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
